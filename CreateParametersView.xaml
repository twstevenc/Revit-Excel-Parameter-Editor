<Window x:Class="RevitParameterEditor.CreateParametersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="建立參數" Height="640" Width="900" MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="CheckItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MinWidth="150"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#666666" Margin="8,0,0,0"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 設定檔選擇 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="設定檔：" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox Grid.Column="1" x:Name="ConfigComboBox" DisplayMemberPath="Name" Margin="6,0"
                      SelectionChanged="ConfigComboBox_SelectionChanged"/>
            <Button Grid.Column="2" x:Name="BrowseButton" Padding="12,3" Click="BrowseButton_Click">
                <TextBlock Text="瀏覽..."/>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="ConfigPathText" Foreground="#888888" FontSize="11"
                   Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>

        <!-- 參數與品類清單 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0" Click="ParamNone_Click">
                        <TextBlock Text="全不選"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Padding="8,2" Click="ParamAll_Click">
                        <TextBlock Text="全選"/>
                    </Button>
                    <TextBlock x:Name="ParamCountText" Text="參數" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="ParameterListBox" ItemTemplate="{StaticResource CheckItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0" Click="CategoryNone_Click">
                        <TextBlock Text="全不選"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Padding="8,2" Click="CategoryAll_Click">
                        <TextBlock Text="全選"/>
                    </Button>
                    <TextBlock x:Name="CategoryCountText" Text="品類" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="CategoryListBox" ItemTemplate="{StaticResource CheckItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- 狀態與按鈕 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Padding="18,5" Margin="8,0,0,0"
                    IsCancel="True">
                <TextBlock Text="取消"/>
            </Button>
            <Button DockPanel.Dock="Right" x:Name="CreateButton" Padding="18,5" IsDefault="True"
                    Background="#217346" Foreground="White" FontWeight="Bold" Click="CreateButton_Click">
                <TextBlock Text="建立參數"/>
            </Button>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#444444"/>
        </DockPanel>
    </Grid>
</Window>
